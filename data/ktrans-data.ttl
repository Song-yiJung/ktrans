kt:CS-CS046 a crm:E13_Attribute_Assignment ;
    crm:P2_has_type kt:type-criticism , kt:st-evaluation ;
    rdfs:label "목사부인·C백작·폰 B양 등 주변 인물이 생략되었다"@ko ;
