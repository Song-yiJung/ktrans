@prefix ktrans: <https://ktrans.aks.ac.kr/ontology#> .
@prefix kt:     <https://ktrans.aks.ac.kr/id/> .
@prefix lrmoo:  <http://iflastandards.info/ns/lrm/lrmoo/> .
@prefix crm:    <http://www.cidoc-crm.org/cidoc-crm/7.1.3/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .


### 메모 규칙 · Note convention ##################################
# 모든 노드의 설명은 crm:P3_has_note 하나에 담는다. 한국어(@ko)와 영어(@en)를 함께 둔다.
# Every node carries its context in crm:P3_has_note, in Korean (@ko) and English (@en).
# (설명) description — 자료에 적힌 사실 · what the source says
# (해석) interpretation — 누군가의 판단, 이름을 함께 쓴다 · someone's judgement, named
# (편찬) compilation — 데이터를 만든 사람의 판단 · the compiler's decision
# (근거) evidence — 문단 번호나 문헌 · paragraph or reference
# 출처 Source: UeDeKo http://www.uedeko.or.kr/wiki2/index.php?title=젊은_베르터의_고뇌_(Die_Leiden_des_jungen_Werthers)

### 작품과 원천 표현형 ########################################

kt:W01 a lrmoo:F1_Work ;
    rdfs:label "젊은 베르터의 고뇌"@ko , "Die Leiden des jungen Werthers"@de ;
    crm:P1_is_identified_by kt:nomen-W01-de .

kt:ev-W01 a lrmoo:F27_Work_Creation ;
    lrmoo:R16_created kt:W01 ;
    crm:P14_carried_out_by kt:P-goethe ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1774"^^xsd:gYear ] .

kt:nomen-W01-de a lrmoo:F12_Nomen ;
    crm:P2_has_type kt:type-title ;
    lrmoo:R33_has_string "Die Leiden des jungen Werthers" ;
    lrmoo:R54_has_language kt:lang-de .

kt:E_de a lrmoo:F2_Expression ;
    rdfs:label "독일어 원문 (1774, Weygand)"@ko ;
    rdfs:label "German original (1774, Weygand)"@en ;
    crm:P72_has_language kt:lang-de ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1774"^^xsd:gYear ] .
kt:W01 lrmoo:R3_is_realised_in kt:E_de .

kt:E_zh a lrmoo:F2_Expression ;
    rdfs:label "궈모뤄 중국어역 少年維特之煩惱 (1922, 泰東書局)"@ko ;
    rdfs:label "Guo Moruo's Chinese translation 少年維特之煩惱 (1922, Taidong Shuju)"@en ;
    crm:P72_has_language kt:lang-zh ;
    lrmoo:R76_is_derivative_of kt:E_de ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1922"^^xsd:gYear ] .
kt:W01 lrmoo:R3_is_realised_in kt:E_zh .

kt:E_ja_takayama a lrmoo:F2_Expression ;
    rdfs:label "다카야마 초규 일본어역 (1891, 山形日報 연재)"@ko ;
    rdfs:label "Takayama Chogyū's Japanese translation (1891, serialised in Yamagata Nippō)"@en ;
    crm:P72_has_language kt:lang-ja ;
    lrmoo:R76_is_derivative_of kt:E_de ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1891"^^xsd:gYear ] ;
    crm:P3_has_note """(설명) 원작의 약 4/5 분량을 옮긴 일본어역이다. 『山形日報』에 연재되었다.
(해석) 김동소는 이 번역을 김영보 역(1923)의 저본으로 추정한다.
(근거) para_12"""@ko ,
                    """(description) A Japanese translation covering about four fifths of the original, serialised in Yamagata Nippō (山形日報).
(interpretation) Kim Dong-so infers that this was the source of Kim Yeong-bo's translation (1923).
(evidence) para_12"""@en .
kt:W01 lrmoo:R3_is_realised_in kt:E_ja_takayama .


### 번역본 ##################################################

kt:T001 a ktrans:Translation ;
    rdfs:label "웰텔의 悲歌"@ko ;
    skos:altLabel "웰텔의 悲歎"@ko ;
    crm:P72_has_language kt:lang-ko ;
    ktrans:sourceType kt:cov-partial ;
    ktrans:viaType kt:via-unstated ;
    lrmoo:R76_is_derivative_of kt:E_de ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1923"^^xsd:gYear ] ;
    crm:P3_has_note """(설명) 게재 형태는 잡지 연재이다. 게재처는 『時事評論』(時事評論社)이다. 게재 시기는 1923.1~1923.9이다.
(설명) UeDeKo 비고: 잡지 연재. <김영보 전집>에 따라 표기함. 역자가 축약 번역했음을 밝힘
(편찬) UeDeKo 레코드 1~4·19번(5건)을 한 작품으로 통합했다(연재). 시사평론 2권 1~5호 잡지 연재 5건."""@ko ,
                    """(description) Publication form: magazine serial. Venue: Sisa Pyeongnon (時事評論), 時事評論社. Published 1923.1–1923.9.
(description) UeDeKo remark: Magazine serial. Recorded after the Kim Yeong-bo Complete Works. The translator states that the translation is abridged
(compilation) UeDeKo records 1–4, 19 (5 records) were merged into one work (serial). Five magazine instalments in Sisa Pyeongnon vol. 2, nos. 1–5."""@en .
kt:W01 lrmoo:R3_is_realised_in kt:T001 .

kt:ev-T001 a lrmoo:F28_Expression_Creation ;
    crm:P2_has_type kt:type-translation-event ;
    lrmoo:R17_created kt:T001 ;
    lrmoo:R19_created_a_realisation_of kt:W01 ;
    crm:P14_carried_out_by kt:P-김영보 ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1923"^^xsd:gYear ] .

kt:nomen-T001 a lrmoo:F12_Nomen ;
    crm:P2_has_type kt:type-title ;
    lrmoo:R33_has_string "웰텔의 悲歌" ;
    lrmoo:R54_has_language kt:lang-ko ;
    lrmoo:R56_has_related_form kt:nomen-W01-de ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1923"^^xsd:gYear ] ;
    crm:P1_is_identified_by "kt:T001" ;
    crm:P3_has_note """(설명) 원제의 Leiden을 '悲歌'로 옮겼다."""@ko ,
                    """(description) The title renders Leiden as '悲歌'."""@en .

kt:T005 a ktrans:Translation ;
    rdfs:label "少年 벨테르의 悲惱"@ko ;
    skos:altLabel "少年 벨테르의 悲惱 1"@ko ;
    crm:P72_has_language kt:lang-ko ;
    ktrans:sourceType kt:cov-partial ;
    ktrans:viaType kt:via-unstated ;
    lrmoo:R76_is_derivative_of kt:E_de ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1923"^^xsd:gYear ] ;
    crm:P3_has_note """(설명) 게재 형태는 신문 연재이다. 게재처는 『每日申報』(每日申報社)이다. 게재 시기는 1923.8.16~1923.9.27이다.
(설명) UeDeKo 비고: 신문 연재, 1부만 번역함 / 신문 연재, 1부만 번역함. 실물 확인불가하지만, 해당 호가 실렸음을 유추할 수 있음 / 신문 연재, 1부만 번역함. 작품 순서상 9월 12일자와 13일자 내용 바뀌어 잘못 인쇄된 것으로 보임, 본문 표기는 지워져서 읽을 수 없지만 27로 표기함 / 신문 연재, 1부만 번역함. 작품 순서상 9월 12일자와 13일자 내용 바뀌어 잘못 인쇄된 것으로 보임 / 신문 연재, 1부만 번역함. 웹상에 30으로 표기되어 있으나 39에 해당됨
(편찬) UeDeKo 레코드 5~18·20~44번(39건)을 한 작품으로 통합했다(연재). 매일신보 1923.8.16~9.27 신문 연재 39건. 원 연재는 40회이나 9회분이 목록에 미등재. 13번(10회)은 실물 확인불가로 등재됨."""@ko ,
                    """(description) Publication form: newspaper serial. Venue: Maeil Sinbo (每日申報), 每日申報社. Published 1923.8.16–1923.9.27.
(description) UeDeKo remark: Newspaper serial; Part One only / Newspaper serial; Part One only. The issue could not be inspected, but its publication can be inferred / Newspaper serial; Part One only. The 12 and 13 September instalments appear swapped; the number is illegible in print and recorded as 27 / Newspaper serial; Part One only. The 12 and 13 September instalments appear to have been printed in the wrong order / Newspaper serial; Part One only. Numbered 30 online, but it is instalment 39
(compilation) UeDeKo records 5–18, 20–44 (39 records) were merged into one work (serial). 39 newspaper instalments in Maeil Sinbo, 16 Aug – 27 Sep 1923. The serial ran 40 times; instalment 9 is not listed. Record 13 (instalment 10) is listed although the issue could not be inspected."""@en .
kt:W01 lrmoo:R3_is_realised_in kt:T005 .

kt:ev-T005 a lrmoo:F28_Expression_Creation ;
    crm:P2_has_type kt:type-translation-event ;
    lrmoo:R17_created kt:T005 ;
    lrmoo:R19_created_a_realisation_of kt:W01 ;
    crm:P14_carried_out_by kt:P-양건식 ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1923"^^xsd:gYear ] .

kt:nomen-T005 a lrmoo:F12_Nomen ;
    crm:P2_has_type kt:type-title ;
    lrmoo:R33_has_string "少年 벨테르의 悲惱" ;
    lrmoo:R54_has_language kt:lang-ko ;
    lrmoo:R56_has_related_form kt:nomen-W01-de ;
    crm:P4_has_time-span [ a crm:E52_Time-Span ; crm:P82_at_some_time_within "1923"^^xsd:gYear ] ;
    crm:P1_is_identified_by "kt:T005" ;
    crm:P3_has_note """(설명) 원제의 Leiden을 '悲惱'로 옮겼다."""@ko ,
                    """(description) The title renders Leiden as '悲惱'."""@en .

